# ==============================================================================
# NexusFreight / FleetHarbor Logistics AI Chatbot — Environment Configuration
# Copy this file to .env and fill in credentials before running in production.
# Never commit .env to version control.
# ==============================================================================

# ── Groq LLM Settings ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
MAX_ANSWER_TOKENS=1024
QUERY_MAX_LENGTH=2000

# ── Relational Database (Local SQLite + Optional Supabase PostgreSQL) ──────────
SHIPMENT_DB_PATH=data/raw/shipments.db
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=5
DB_CONNECT_TIMEOUT=10

# ── Embedding Model Settings ───────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# ── Vector Store & Retrieval Tuning ────────────────────────────────────────────
VECTOR_STORE=auto
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# ── ChromaDB Settings ──────────────────────────────────────────────────────────
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=logistics_knowledge_chunks
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# ── Server, Session & Upload Settings ──────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=10485760
