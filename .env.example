# ==============================================================================
# FleetHarbor Logistics AI Chatbot - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with secrets to Git.
# ==============================================================================

# ── Groq LLM Configuration ───────────────────────────────────────────────────
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Recommended model: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=15

# ── Supabase PostgreSQL Database (Direct connection via psycopg2) ────────────
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# ── Supabase REST / Client Credentials (Optional / Fallback) ──────────────────
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# anon key (public, subject to RLS)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# service-role key (backend only, bypasses RLS for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Alias for backwards compatibility
SUPABASE_KEY=your_supabase_anon_key_here

# ── Embedding Model Configuration ─────────────────────────────────────────────
# Default: all-MiniLM-L6-v2 (384 dimensions, fast and accurate for RAG)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval Tuning ──────────────────────────────────────────────────────────
# Number of relevant document chunks to return
RETRIEVAL_TOP_K=5
# Minimum cosine similarity threshold (0.0 to 1.0)
RETRIEVAL_MIN_SCORE=0.3
# Vector store selection: 'auto' (prefers ChromaDB then Supabase) | 'chroma' | 'supabase'
VECTOR_STORE=auto

# ── ChromaDB Vector Database Configuration ────────────────────────────────────
# Deployment mode: 'persistent' (local directory) | 'http' (self-hosted server) | 'cloud' (Chroma Cloud)
CHROMA_MODE=persistent

# Persistent directory for Option A (Local Persistent ChromaDB)
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Collection name for logistics knowledge embeddings
CHROMA_COLLECTION_NAME=logistics_knowledge_chunks

# For Option B (Self-hosted Chroma server)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# For Option C (Chroma Cloud)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Embedding provider: 'sentence-transformers'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_API_KEY=

